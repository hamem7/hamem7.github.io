rules_version = '2';

// ==========================================================
// 🌟 [إصلاح تدقيق ما قبل الإطلاق] قواعد Firestore = رفض كامل
// ==========================================================
// نظام الواجبات انتقل بالكامل إلى خادم Google Apps Script + Sheets (راجع core/api.js و
// Dar-Ham-Homework-Lab/backend/Code.gs) ولم يعد أي كود نشط في المنصة يقرأ من Firestore أو يكتب فيه
// (تحققنا: لا استيراد لـ core/firebase.js في أي شاشة). القواعد القديمة كانت تسمح بقراءة كل التسليمات
// (get/list: if true) — أي شخص يعرف اسم المشروع كان يستطيع سحب أسماء الطلاب وإجاباتهم. الآن كل شيء مغلق.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
