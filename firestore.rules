rules_version = '2';

// ==========================================================
// 🌟 قواعد أمان Firestore — منصة دار حم
// ==========================================================
// [افتراض صريح مهم]: هذا الملف مبني على أساس إن التطبيق حالياً بلا أي تسجيل دخول
// حقيقي (لا للمعلم ولا للطلاب) — تأكدت من ده بمراجعة core/firebase.js وكل الشاشات.
// معنى ده: القواعد دي متقدرش تفرّق بين "طلب جاي من تطبيقكم الفعلي" و"طلب جاي من
// أي حد تاني عارف اسم المشروع (darham-quran)". أقصى ما تقدر تعمله القواعد وحدها في
// الوضع ده هو: (أ) التحقق من شكل البيانات (schema) قبل قبولها، و(ب) منع عمليات
// معينة تمامًا (حذف، سرد كامل غير ضروري) حتى لو محدش بيستخدمها دلوقتي.
//
// ⚠️ النقطة اللي القواعد وحدها متقدرش تقفلها: قراءة/تعديل كل تسليمات الطلاب
// (submissions) وكتابة الواجبات (homeworks) مستخدمة من شاشة المعلم نفسها، وبما إنه
// مفيش أي هوية موثقة للمعلم في الكود، القواعد دي سيبتها مفتوحة (allow: if true) مع
// علامة ⚠️ على كل سطر منها. القفل الكامل ليها محتاج إضافة تسجيل دخول حقيقي للمعلم
// (Firebase Authentication) — ده موضوع منفصل نقدر نتكلم فيه بعد ما تراجع الملف ده.

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 📚 الواجبات (homeworks)
    // ==========================================
    match /homeworks/{hwId} {
      // الطالب بيجيب واجبه بمعرفه المحدد فقط (رابط ?hw=HW_xxxx) — قراءة مستند واحد بمعرفه مسموحة.
      allow get: if true;

      // 🌟 منع سرد/تعداد كل الواجبات دفعة واحدة — يمنع أي حد يكتشف كل أسئلة وإجابات
      // كل واجبات المعلم بدون ما يعرف روابطها تحديدًا.
      allow list: if false;

      // ⚠️ الكتابة (نشر/تعديل واجب من homework-prep.js) — مفتوحة حاليًا لغياب تسجيل
      // دخول المعلم، لكن محكومة بالتحقق من شكل البيانات على الأقل.
      allow create, update: if isValidHomework(request.resource.data);

      // لا حذف من العميل إطلاقًا — أي حذف للواجب يتم يدويًا من لوحة Firebase فقط حاليًا.
      allow delete: if false;
    }

    // ==========================================
    // 📊 تسليمات الطلاب (submissions)
    // ==========================================
    match /submissions/{submissionId} {
      // 🌟 الطالب يقدر يرسل تسليمه مرة واحدة فقط (create) — بشرط مطابقة الشكل المتوقع تمامًا.
      allow create: if isValidSubmission(request.resource.data);

      // 🌟 تحديث محصور فعليًا في حقلي التصحيح اليدوي (score, details) فقط — نفس
      // الحقلين بالضبط اللي بيبعتهم updateSubmissionInCloud في homework-prep.js —
      // فحتى لو حد استغل الفتحة دي، أقصى ما يقدر يعمله هو تغيير درجة/تفاصيل تسليم
      // موجود بالفعل، مش أي حقل تاني (زي studentName أو hwId).
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['score', 'details']);

      allow delete: if false;

      // ⚠️⚠️ أخطر نقطة في الملف كله: قراءة/سرد كل التسليمات (list) مستخدمة فقط من
      // شاشتي المعلم (homework-prep.js لعرض من يحتاج تصحيح، و monthly-report.js
      // لتجميع درجات الشهر) — وبما إن مفيش تسجيل دخول للمعلم، السطر ده حاليًا بيسمح
      // لأي حد يعرف اسم المشروع بقراءة أسماء ودرجات وتسجيلات صوت كل الطلاب.
      // [قرار مطلوب منك]: سيبتها كده مؤقتًا (خطر خصوصية حقيقي على بيانات أطفال)، أو
      // نضيف تسجيل دخول حقيقي للمعلم ونستبدل "if true" بشرط يتحقق من هويته.
      allow get, list: if true; // ⚠️ راجع الملاحظة فوق قبل النشر
    }

    // ==========================================
    // 🔒 أي مجموعة تانية غير متوقعة — مرفوضة بالكامل افتراضيًا (Deny by default)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // ✅ دوال التحقق من شكل البيانات
    // ==========================================

    function isValidHomework(data) {
      return data.keys().hasAll(['id', 'createdAt', 'questions'])
        && data.id is string && data.id.size() < 100
        && data.createdAt is string
        && data.questions is list
        && data.questions.size() > 0 && data.questions.size() < 200; // حد أقصى معقول لعدد الأسئلة
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['hwId', 'studentId', 'studentName', 'timestamp', 'details'])
        && data.hwId is string && data.hwId.size() < 100
        && data.studentName is string && data.studentName.size() < 200
        && data.timestamp is number
        // منع تسليمات بتاريخ مستقبلي أو متلاعب بيه (هامش 5 دقائق لفروق ساعة الجهاز)
        && data.timestamp <= request.time.toMillis() + 300000
        && data.details is list;
    }
  }
}
