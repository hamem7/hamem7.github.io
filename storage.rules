rules_version = '2';

// ==========================================================
// 🌟 قواعد أمان Firebase Storage — منصة دار حم (التسجيلات الصوتية)
// ==========================================================
// نفس [الافتراض الصريح] الموجود في firestore.rules بالضبط: لا يوجد تسجيل دخول حقيقي
// حالياً لا للمعلم ولا للطالب، فالقواعد دي بتعتمد فقط على التحقق من شكل/حجم/نوع
// الملف، مش على هوية مين بيرفع أو بيقرأ.

service firebase.storage {
  match /b/{bucket}/o {

    // مسار التسجيلات الصوتية كما هو مستخدم فعليًا في core/firebase.js
    // (uploadAudioAndGetUrl): homework_audio/{submissionId}/{questionId}.webm
    match /homework_audio/{submissionId}/{fileName} {

      // 🌟 رفع التسجيل أثناء حل الطالب للواجب — تحقق من إن الملف صوت فعلاً وحجمه معقول
      // (يمنع رفع ملفات عشوائية كبيرة لإغراق مساحة التخزين المجانية بالمشروع).
      allow write: if request.resource.contentType.matches('audio/.*')
                   && request.resource.size < 8 * 1024 * 1024; // حد أقصى 8 ميجابايت للتسجيل الواحد

      // ⚠️ قراءة الصوت (تشغيله في لوحة تصحيح المعلم) — نفس ملاحظة submissions في
      // firestore.rules بالضبط: مفتوحة مؤقتًا لغياب تسجيل دخول المعلم. أي حد يعرف أو
      // يخمّن مسار الملف (submissionId) يقدر يسمع التسجيل الصوتي لطفل.
      allow read: if true; // ⚠️ راجع نفس الملاحظة في firestore.rules قبل النشر
    }

    // 🔒 أي مسار تاني غير متوقع في نفس الـ Storage bucket — مرفوض بالكامل افتراضيًا
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
