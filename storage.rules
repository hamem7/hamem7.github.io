rules_version = '2';

// 🌟 [إصلاح تدقيق ما قبل الإطلاق] قواعد Storage = رفض كامل (نفس سبب firestore.rules: لا كود نشط يستخدمه،
// وكانت القراءة العامة لتسجيلات الطلاب الصوتية مفتوحة لأي شخص).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
